# PANDA's core is fully local and offline: it needs no credentials or API keys.
# The opt-in extras do (see below); the core ignores them.

# --- core (offline) ---
# Where the encrypted vault file lives. Default: ~/.panda/vault.db.
# Uncomment to override (e.g. for tests):
# PANDA_DB_PATH=/absolute/path/to/vault.db

# --- [ai] extra: LLM-polished reports (pip install -e '.[ai]') ---
# Gemini API key. Without it, reports stay deterministic (the safe default).
# GEMINI_API_KEY=your-key-here

# --- [live] extra: live Splunk pull (pip install -e '.[live]') ---
# Splunk connection. Without these (or with Splunk unreachable), `tdr live`
# falls back to the offline snapshot.
# SPLUNK_HOST=localhost
# SPLUNK_PORT=8089
# SPLUNK_USER=your-splunk-user
# SPLUNK_PASSWORD=your-splunk-password
# SPLUNK_VERIFY=false
